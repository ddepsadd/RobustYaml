<idea-plugin require-restart="true">
  <id>com.jetbrains.rider.plugins.robustyaml</id>
  <name>RobustYaml</name>
  <version>_PLACEHOLDER_</version>
  <vendor url="https://project-url">Author</vendor>
  <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_" />
  <depends>com.intellij.modules.rider</depends>

  <dependencies>
    <module name="intellij.yaml" />
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <annotator language="yaml"
               implementationClass="com.jetbrains.rider.plugins.robustyaml.highlighting.RobustYamlAnnotator" />
    <annotator language="TEXT"
               implementationClass="com.jetbrains.rider.plugins.robustyaml.highlighting.RobustUnusedLocalizationAnnotator" />
    <annotator language="XML"
               implementationClass="com.jetbrains.rider.plugins.robustyaml.highlighting.RobustGuidebookAnnotator" />
    <additionalLibraryRootsProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.project.RobustPrototypeRootsProvider" />
    <solutionExplorerRootProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.project.RobustPrototypeTreeRoot" />
    <solutionExplorerCustomization
        implementation="com.jetbrains.rider.plugins.robustyaml.project.RobustSolutionExplorerProblems" />
    <colorSettingsPage
        implementation="com.jetbrains.rider.plugins.robustyaml.highlighting.RobustYamlColorSettingsPage" />
    <colorProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.highlighting.RobustColorProvider" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustComponentNameIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustPrototypeKindIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustPrototypeIdIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustPrototypeIdsByKindIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustDataFieldIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustYamlReferenceIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustLocaleIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustYamlValueIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustLocaleUsageIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.index.RobustLocaleAffixIndex" />
    <findUsagesHandlerFactory
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustFindUsagesHandlerFactory" />
    <targetElementEvaluator
        language="yaml"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.navigation.RobustTargetElementEvaluator" />
    <renamePsiElementProcessor
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustRenameProcessor" />
    <renamePsiElementProcessor
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustLocaleRenameProcessor" />
    <renameHandler
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustLocaleRenameHandler" />
    <renameInputValidator
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustLocaleNameValidator" />
    <gotoDeclarationHandler
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustLocaleDeclarationHandler" />
    <usageTargetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustLocaleUsageTargetProvider" />
    <nonProjectFileWritingAccessExtension
        implementation="com.jetbrains.rider.plugins.robustyaml.project.RobustFileWritingAccess" />
    <elementDescriptionProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustElementDescription" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownPrototypeId"
        displayName="Unknown prototype id"
        groupName="Robust YAML"
        level="WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustUnknownPrototypeIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustDuplicatePrototypeId"
        displayName="Duplicate prototype id"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustDuplicatePrototypeIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustInvalidEnumValue"
        displayName="Invalid enum value"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustInvalidEnumValueInspection" />
    <localInspection
        language="yaml"
        shortName="RobustInvalidScalarValue"
        displayName="Invalid number or boolean value"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustInvalidScalarValueInspection" />
    <localInspection
        language="yaml"
        shortName="RobustMissingRequiredField"
        displayName="Required datafield is not set"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustMissingRequiredFieldInspection" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownLocalizationId"
        displayName="Unknown localization message id"
        groupName="Robust YAML"
        level="WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustUnknownLocalizationIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownField"
        displayName="Unknown component or prototype field"
        groupName="Robust YAML"
        level="WEAK WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.inspection.RobustUnknownFieldInspection" />
    <gotoSymbolContributor
        implementation="com.jetbrains.rider.plugins.robustyaml.navigation.RobustPrototypeSymbolContributor" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.documentation.RobustSpriteDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.documentation.RobustTypeDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.documentation.RobustLocalizationDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.documentation.RobustPrototypeDocumentationProvider" />
    <psi.referenceContributor
        language="yaml"
        implementation="com.jetbrains.rider.plugins.robustyaml.reference.RobustYamlReferenceContributor" />
    <psi.referenceContributor
        language="XML"
        implementation="com.jetbrains.rider.plugins.robustyaml.reference.RobustGuidebookReferenceContributor" />
    <codeStyleSettingsModifier
        implementation="com.jetbrains.rider.plugins.robustyaml.editor.RobustCodeStyleModifier" />
    <typedHandler
        order="last"
        implementation="com.jetbrains.rider.plugins.robustyaml.editor.RobustSequenceIndentHandler" />
    <editorActionHandler
        action="EditorEnter"
        order="last"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.editor.RobustSequenceEnterHandler" />
    <completion.contributor
        language="yaml"
        order="first"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.completion.RobustComponentCompletionContributor" />
    <lookup.charFilter
        implementation="com.jetbrains.rider.plugins.robustyaml.completion.RobustLookupCharFilter" />
    <projectConfigurable
        id="com.jetbrains.rider.plugins.robustyaml.settings"
        parentId="tools"
        displayName="Robust YAML"
        instance="com.jetbrains.rider.plugins.robustyaml.project.RobustYamlConfigurable" />
  </extensions>

  <description>
<![CDATA[
<p>Sample description</p>
]]>
  </description>

</idea-plugin>
