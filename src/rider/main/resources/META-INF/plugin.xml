<idea-plugin require-restart="true">
  <id>com.jetbrains.rider.plugins.robustyaml</id>
  <name>RobustYaml</name>
  <version>_PLACEHOLDER_</version>
  <vendor url="https://project-url">Author</vendor>
  <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_" />
  <depends>com.intellij.modules.rider</depends>

  <dependencies>
    <module name="intellij.yaml" />
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <annotator language="yaml"
               implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustYamlAnnotator" />
    <additionalLibraryRootsProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeRootsProvider" />
    <colorSettingsPage
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustYamlColorSettingsPage" />
    <projectConfigurable
        id="com.jetbrains.rider.plugins.robustyaml.settings"
        parentId="tools"
        displayName="Robust YAML"
        instance="com.jetbrains.rider.plugins.robustyaml.RobustYamlConfigurable" />
  </extensions>

  <description>
<![CDATA[
<p>Sample description</p>
]]>
  </description>

</idea-plugin>
