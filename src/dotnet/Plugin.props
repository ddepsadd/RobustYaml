<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.ReSharper.SDK -->
    <!-- Keep in sync with ProductVersion in gradle.properties -->
    <SdkVersion>2026.2.0.1</SdkVersion>

    <Title>RobustYaml</Title>
    <Description>Rider support for the YAML prototypes of Robust Toolbox, the format the content of Space Station 14 is written in: completion and validation driven by the C# of the engine, navigation between YAML, localization and code, sprite previews and prototype hierarchy.</Description>

    <Authors>Depsad</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Depsad</Copyright>
    <PackageTags>rider resharper plugin yaml space-station-14 robust-toolbox</PackageTags>

    <PackageProjectUrl>https://github.com/ddepsadd/RobustYaml</PackageProjectUrl>
    <!-- PackageLicenseUrl is deprecated by NuGet; an SPDX expression is the current form. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
