<idea-plugin require-restart="true">
  <id>com.jetbrains.rider.plugins.robustyaml</id>
  <name>RobustYaml</name>
  <version>_PLACEHOLDER_</version>
  <vendor url="https://project-url">Author</vendor>
  <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_" />
  <depends>com.intellij.modules.rider</depends>

  <dependencies>
    <module name="intellij.yaml" />
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <annotator language="yaml"
               implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustYamlAnnotator" />
    <additionalLibraryRootsProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeRootsProvider" />
    <solutionExplorerRootProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeTreeRoot" />
    <solutionExplorerCustomization
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustSolutionExplorerProblems" />
    <colorSettingsPage
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustYamlColorSettingsPage" />
    <colorProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustColorProvider" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustComponentNameIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeKindIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeIdIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeIdsByKindIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustDataFieldIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustYamlReferenceIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustYamlValueIndex" />
    <fileBasedIndex
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleUsageIndex" />
    <findUsagesHandlerFactory
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustFindUsagesHandlerFactory" />
    <targetElementEvaluator
        language="yaml"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustTargetElementEvaluator" />
    <renamePsiElementProcessor
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustRenameProcessor" />
    <renamePsiElementProcessor
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleRenameProcessor" />
    <renameHandler
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleRenameHandler" />
    <renameInputValidator
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleNameValidator" />
    <gotoDeclarationHandler
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleDeclarationHandler" />
    <usageTargetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocaleUsageTargetProvider" />
    <nonProjectFileWritingAccessExtension
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustFileWritingAccess" />
    <elementDescriptionProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustElementDescription" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownPrototypeId"
        displayName="Unknown prototype id"
        groupName="Robust YAML"
        level="WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustUnknownPrototypeIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustDuplicatePrototypeId"
        displayName="Duplicate prototype id"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustDuplicatePrototypeIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustInvalidEnumValue"
        displayName="Invalid enum value"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustInvalidEnumValueInspection" />
    <localInspection
        language="yaml"
        shortName="RobustInvalidScalarValue"
        displayName="Invalid number or boolean value"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustInvalidScalarValueInspection" />
    <localInspection
        language="yaml"
        shortName="RobustMissingRequiredField"
        displayName="Required datafield is not set"
        groupName="Robust YAML"
        level="ERROR"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustMissingRequiredFieldInspection" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownLocalizationId"
        displayName="Unknown localization message id"
        groupName="Robust YAML"
        level="WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustUnknownLocalizationIdInspection" />
    <localInspection
        language="yaml"
        shortName="RobustUnknownField"
        displayName="Unknown component or prototype field"
        groupName="Robust YAML"
        level="WEAK WARNING"
        enabledByDefault="true"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustUnknownFieldInspection" />
    <gotoSymbolContributor
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeSymbolContributor" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustSpriteDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustTypeDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLocalizationDocumentationProvider" />
    <platform.backend.documentation.targetProvider
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustPrototypeDocumentationProvider" />
    <psi.referenceContributor
        language="yaml"
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustYamlReferenceContributor" />
    <codeStyleSettingsModifier
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustCodeStyleModifier" />
    <typedHandler
        order="last"
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustSequenceIndentHandler" />
    <editorActionHandler
        action="EditorEnter"
        order="last"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustSequenceEnterHandler" />
    <completion.contributor
        language="yaml"
        order="first"
        implementationClass="com.jetbrains.rider.plugins.robustyaml.RobustComponentCompletionContributor" />
    <lookup.charFilter
        implementation="com.jetbrains.rider.plugins.robustyaml.RobustLookupCharFilter" />
    <projectConfigurable
        id="com.jetbrains.rider.plugins.robustyaml.settings"
        parentId="tools"
        displayName="Robust YAML"
        instance="com.jetbrains.rider.plugins.robustyaml.RobustYamlConfigurable" />
  </extensions>

  <description>
<![CDATA[
<p>Sample description</p>
]]>
  </description>

</idea-plugin>
